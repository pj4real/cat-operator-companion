# Copy to .env (already gitignored) and fill in your key to enable voice narration.
# Without this, the frontend falls back to the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=
# Optional: pick a specific ElevenLabs voice. Defaults to the premade "Adam" voice.
ELEVENLABS_VOICE_ID=

# Fill in your free key (console.groq.com) to enable LLM-structured near-miss reports
# (POST /structure/incident). Without this, the frontend falls back to its own regex-based structuring.
GROQ_API_KEY=
# Optional: override the default Groq model (llama-3.3-70b-versatile).
GROQ_MODEL=
